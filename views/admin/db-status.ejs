<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Database Status</title>
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="admin-page">
    <%- include('partials/nav') %>
    <main class="admin-shell">
      <h1>Database Status</h1>

      <section class="admin-metrics">
        <article>
          <span>Provider</span>
          <strong><%= dbInfo.provider %></strong>
        </article>
        <article>
          <span>Schema</span>
          <strong><%= dbInfo.schema || '-' %></strong>
        </article>
        <article>
          <span>News posts</span>
          <strong><%= totalNews %></strong>
        </article>
        <article>
          <span>Published</span>
          <strong><%= publishedNews %></strong>
        </article>
        <article>
          <span>Images</span>
          <strong><%= totalImages %></strong>
        </article>
        <article>
          <span>Page views (all)</span>
          <strong><%= pageViewsTotal %></strong>
        </article>
        <article>
          <span>Page views (content only)</span>
          <strong><%= pageViewsContent %></strong>
        </article>
        <article>
          <span>TABEE share</span>
          <strong><%= tabeeStats.sharePercent %>%</strong>
        </article>
      </section>

      <section class="admin-grid">
        <div>
          <h2>Connection</h2>
          <table>
            <tbody>
              <tr>
                <th>Host</th>
                <td><%= dbInfo.host || '-' %></td>
              </tr>
              <tr>
                <th>Database</th>
                <td><%= dbInfo.database || '-' %></td>
              </tr>
              <tr>
                <th>Username</th>
                <td><%= dbInfo.username || '-' %></td>
              </tr>
              <tr>
                <th>SQLite file</th>
                <td><%= dbInfo.filename || '-' %></td>
              </tr>
              <% if (dbDebug && dbInfo.provider === 'postgres') { %>
                <tr>
                  <th>Current schema</th>
                  <td><%= dbDebug.currentSchema || '-' %></td>
                </tr>
                <tr>
                  <th>Search path</th>
                  <td><%= dbDebug.searchPath || '-' %></td>
                </tr>
                <tr>
                  <th>Table schema(s)</th>
                  <td>
                    <% if (dbDebug.tableSchemas.length > 0) { %>
                      <%= dbDebug.tableSchemas.map(function(row) {
                            return row.table_name + ' (' + row.table_schema + ')';
                          }).join(', ') %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div>
          <h2>Analytics Check: TABEE</h2>
          <table>
            <tbody>
              <tr>
                <th>TABEE views</th>
                <td><%= tabeeStats.views %></td>
              </tr>
              <tr>
                <th>Unique IP hash</th>
                <td><%= tabeeStats.uniqueIps %></td>
              </tr>
              <tr>
                <th>Unique User-Agent</th>
                <td><%= tabeeStats.uniqueAgents %></td>
              </tr>
              <tr>
                <th>Direct/no referrer</th>
                <td><%= tabeeStats.directViews %></td>
              </tr>
              <tr>
                <th>Share of content views</th>
                <td><%= tabeeStats.sharePercent %>%</td>
              </tr>
            </tbody>
          </table>

          <h3 style="margin-top: 16px">TABEE (last 14 days)</h3>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Views</th>
              </tr>
            </thead>
            <tbody>
              <% if (tabeeDaily.length > 0) { %>
                <% tabeeDaily.forEach(function(row) { %>
                  <tr>
                    <td><%= row.day %></td>
                    <td><%= row.views %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="2">No TABEE visits found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <h3 style="margin-top: 16px">Potential non-content paths (/api/*)</h3>
          <table>
            <thead>
              <tr>
                <th>Path</th>
                <th>Views</th>
              </tr>
            </thead>
            <tbody>
              <% if (suspiciousPaths.length > 0) { %>
                <% suspiciousPaths.forEach(function(row) { %>
                  <tr>
                    <td><%= row.path %></td>
                    <td><%= row.views %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="2">No /api/* entries found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div>
          <h2>Latest News Rows</h2>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (latestPosts.length > 0) { %>
                <% latestPosts.forEach(function(post) { %>
                  <tr>
                    <td><%= post.id %></td>
                    <td>
                      <strong><%= post.title %></strong>
                      <small>/news/<%= post.slug %></small>
                    </td>
                    <td><%= post.status %></td>
                    <td><%= formatThaiDate(post.published_date) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="4">No news rows found in this database/schema.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>
