<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login</title>
    <link rel="stylesheet" href="/css/admin.css" />
  </head>
  <body class="admin-page admin-login-page">
    <main class="admin-login">
      <h1>เข้าสู่ระบบผู้ดูแล</h1>
      <% if (error) { %>
        <p class="admin-alert"><%= error %></p>
      <% } %>
      <form method="post" action="/admin/login">
        <label>
          ชื่อผู้ใช้
          <input type="text" name="username" value="<%= username || '' %>" required autofocus />
        </label>
        <label>
          รหัสผ่าน
          <input type="password" name="password" required />
        </label>
        <button type="submit">เข้าสู่ระบบ</button>
      </form>
      <p class="admin-note">ชื่อผู้ใช้และรหัสผ่านถูกตั้งค่าจาก ADMIN_USERNAME และ ADMIN_PASSWORD บนเซิร์ฟเวอร์</p>
    </main>
  </body>
</html>
