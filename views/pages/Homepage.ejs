<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/navbar', { title : 'Homepage'} ) %>

    <link rel="stylesheet" href="../css/Home.css?v=<%= buildId %>" />
    <link rel="stylesheet" href="/css/assets/news-card.css?v=<%= buildId %>" />
    <%- include('../partials/Responsive') %>
  </head>
  <body>
    <%- include('../partials/topbtn') %>
    <!-- picture-main -->
    <div class="carousel-wrapper">
      <div
        id="carouselExampleSlidesOnly"
        class="carousel slide"
        data-bs-ride="carousel"
      >
        <div class="carousel-inner">
          <div class="carousel-item active" data-bs-interval="5000">
            <img
              src="../images/Homepage/Homepage-mainpic1.png"
              class="d-block w-100"
              alt="HomepagePic1"
            />
          </div>
          <div class="carousel-item" data-bs-interval="5000">
            <img
              src="../images/Homepage/Homepage-mainpic2.png"
              class="d-block w-100"
              alt="HomepagePic2"
            />
          </div>
          <div class="carousel-item" data-bs-interval="5000">
            <img
              src="../images/Homepage/Homepage-mainpic3.png"
              class="d-block w-100"
              alt="HomepagePic3"
            />
          </div>
          <div class="carousel-item" data-bs-interval="5000">
            <img
              src="../images/Homepage/Homepage-mainpic4.png"
              class="d-block w-100"
              alt="HomepagePic4"
            />
          </div>
        </div>
        <div class="mainpic-gradient"></div>
      </div>
    </div>
    <%- include('../partials/bootstrapend') %>
    <script src="/js/Home-mainpic.js?v=<%= buildId %>"></script>
    <!-- button-main -->
    <div class="hp-button1">
      <a href="/pre">
        <button class="hp-button1-box">
          <div class="hp-button1-main">PRE</div>
          <div class="hp-button1-name">วศ.บ.วิศวกรรมอุตสาหกาาร</div>
        </button>
      </a>
      <a href="/mce">
        <button class="hp-button1-box">
          <div class="hp-button1-main">MCE</div>
          <div class="hp-button1-name">วศ.บ.วิศวกรรมเมคคาทรอนิกส์</div>
        </button>
      </a>
      <a href="/isee">
        <button class="hp-button1-box">
          <div class="hp-button1-main">ISEE</div>
          <div class="hp-button1-name">
            วศ.บ.วิศวกรรมระบบอุตสาหกรรม และการประกอบการธุรกิจ
          </div>
        </button>
      </a>
      <a href="/m_eng">
        <button class="hp-button1-box">
          <div class="hp-button1-main">M.Eng. ISE</div>
          <div class="hp-button1-name">
            วศ.ม.วิศวกรรมอุตสาหการ และระบบการผลิต
          </div>
        </button>
      </a>
      <a href="/ph_d">
        <button class="hp-button1-box">
          <div class="hp-button1-main">Ph.D. ISE</div>
          <div class="hp-button1-name">
            ปร.ด.วิศวกรรมอุตสาหการ และระบบการผลิต
          </div>
        </button>
      </a>
    </div>
    <!-- picture-aboutus -->
    <div class="hp-aboutus">
      <img src="../images/Homepage/Homepage-About.png" alt="AboutusPic" />
      <div class="hp-aboutus-box">
        <h1 class="hp-aboutus-head">เกี่ยวกับเรา</h1>
        <div class="hp-aboutus-body">
          การจัดการเรียนการสอนของภาควิชาวิศวกรรมอุตสาหการ ในทุกหลักสูตร
          ถือว่ามีคุณภาพในลำดับต้นๆ ของประเทศ ผลิตบัณฑิตประมาณ ปีละ 120 คน
          มหาบัณฑิตประมาณปีละ 80 คน ดุษฎีบัณฑิตปีละประมาณ 3-5 คน มีผลงาน
          วิจัยและวิชาการเป็นที่ยอมรับ โดยได้รับการตีพิมพ์ในวารสารวิชาการ
        </div>
        <div>
          <a href="/history_dep" class="aboutus-read-more"
            >อ่านเพิ่มเติม <span><i class="fa-solid fa-arrow-right"></i></span
          ></a>
        </div>
      </div>
    </div>
    <!-- ข่าวสาร -->
    <div class="news-header">
      <h2>ข่าวสารและกิจกรรม</h2>
      <span><a href="/news">ดูทั้งหมด</a></span>
    </div>
    <div class="container-bg">
      <div class="news-grid">
          <% if (typeof latestDbNews !== 'undefined' && latestDbNews.length > 0) { %>
            <% latestDbNews.forEach(function(post) { %>
              <div class="news-grid-item">
                <%- include('../partials/db-news-card', { post: post, formatThaiDate: formatThaiDate }) %>
              </div>
            <% }); %>
          <% } else { %>
            <div class="news-grid-item">
              <p>ไม่มีข่าวสารล่าสุดในขณะนี้</p>
            </div>
          <% } %>
      </div>
    </div>
    <div class="news-row-controls" aria-label="ตัวควบคุมข่าวสาร">
      <button type="button" class="news-row-btn" id="news-prev" aria-label="ข่าวก่อนหน้า">ก่อนหน้า</button>
      <span class="news-row-status" id="news-row-status">1 / 1</span>
      <button type="button" class="news-row-btn" id="news-next" aria-label="ข่าวถัดไป">ถัดไป</button>
    </div>
    <script src="/js/Home-news.js?v=<%= buildId %>"></script>
    <!-- build: <%= buildId %> -->
    <%- include('../partials/footer')-%>
  </body>
</html>
