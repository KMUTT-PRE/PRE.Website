<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('head', { title : 'footer' }) %>

    <script
      src="https://kit.fontawesome.com/f7cbfce543.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="../css/assets/footer.css" />
    <link rel="stylesheet" href="../css/assets/Responsive.css" />
  </head>
  <body>
    <footer id="footer" class="footer">
      <div class="footer-content">
        <!-- LEFT SECTION -->
        <div class="footer-link">
          <span class="footer-brand">
            <a href="https://www.kmutt.ac.th/" target="_blank" class="brand1">
              <img src="../images/KMUTT_Logo.png" alt="kmuttlogo" />
            </a>

            <span href="#" class="brand2">
              <img src="../images/PEMCE-LOGO.png" alt="prelogo" />
            </span>
          </span>
          <div class="footer-visit-stats">
            <div>
              <span>เดือนนี้</span>
              <strong class="fw-normal"><%= typeof analyticsSummary !== 'undefined' ? analyticsSummary.monthViews : 0 %></strong>
            </div>
            <div>
              <span>ปีนี้</span>
              <strong class="fw-normal"><%= typeof analyticsSummary !== 'undefined' ? analyticsSummary.yearViews : 0 %></strong>
            </div>
          </div>
        </div>
        <div>
          <!-- ลิงก์ด่วน -->
          <h3>QuickLinks</h3>
          <ul class="footer-ul">
            <li><a href="https://www.leb2.org/" target="_blank">LEB2</a></li>
            <li>
              <a href="https://sinfo.kmutt.ac.th/" target="_blank">NewAcis</a>
            </li>
          </ul>
        </div>
        <!-- socialmedia -->
        <div class="social">
          <h3>Social Media</h3>
          <div class="social-row">
            <i class="fa-brands fa-facebook"></i>
            <div class="social-text">
              <a
                href="https://www.facebook.com/profile.php?id=100063531941398&locale=bg_BG#"
                target="_blank"
                class="social"
                >ภาควิชาวิศวกรรมอุตสาหการ</a
              >
              <a
                href="https://www.facebook.com/prekmutt"
                target="_blank"
                class="social"
                >บัณฑิตศึกษาอุตสาหการ</a
              >
              <a
                href="https://www.facebook.com/modpemce"
                target="_blank"
                class="social"
                >ชมรมมดอุตสาหการและเมคคาทรอนิกส์</a
              >
            </div>
          </div>
          <div class="social-row">
            <i class="fa-brands fa-youtube"></i>
            <div class="social-text">
              <a
                href="https://www.youtube.com/results?search_query=%E0%B8%A7%E0%B8%B4%E0%B8%A8%E0%B8%A7%E0%B8%81%E0%B8%A3%E0%B8%A3%E0%B8%A1%E0%B8%AD%E0%B8%B8%E0%B8%95%E0%B8%AA%E0%B8%B2%E0%B8%AB%E0%B8%81%E0%B8%B2%E0%B8%A3+%E0%B8%A1%E0%B8%88%E0%B8%98"
                target="_blank"
                class="social"
                >วิศวกรรมอุตสาหการ มจธ</a
              >
            </div>
          </div>
        </div>

        <!-- CENTER SECTION -->
        <div class="footer-contact">
          <h3>Contact Us</h3>
          <div class="footer-body">
            <p>
              King Mongkut's University of Technology Thonburi<br />
              อาคารวิศววัฒนะ ชั้น8 126 ถนนประชาอุทิศ <br />
              แขวงบางมด เขตทุ่งครุ กรุงเทพฯ 10140
            </p>

            <div class="contact">
              <div class="contact-row">
                <i class="fa-solid fa-phone"></i>
                <div class="phone-group">
                  <p class="contact-number">+66 2-470-9175-7</p>
                  <p>2-470-9179</p>
                </div>
              </div>
              <div class="contact-row">
                <i class="fa-regular fa-envelope"></i>
                <p class="contact-email">production_engineering@kmutt.ac.th</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <hr class="line" />
        <div class="text-center">Copyright © 2026 PE KMUTT.</div>
      </div>
    </footer>
    <button
      type="button"
      class="consent-floating-button"
      id="consentOpenButton"
      aria-controls="consentPopup"
      aria-expanded="false"
    >
      ขอความยินยอม/Request for Consent
    </button>
    <div class="consent-popup" id="consentPopup" aria-hidden="true">
      <div class="consent-copy consent-copy-en">
        <div class="consent-title-row">
          <img src="../images/KMUTT_Logo.png" alt="KMUTT" />
          <h2>Cookie Consent</h2>
        </div>
        <p>
          This website uses cookies to improve user experience. By using our
          website you consent to all cookies in accordance with our Cookie
          Policy.
        </p>
        <p class="consent-links">
          <a href="https://www.kmutt.ac.th/privacy/" target="_blank">Privacy policy</a>
          <span>-</span>
          <a href="https://www.kmutt.ac.th/website-policy/" target="_blank">Terms and condition</a>
        </p>
      </div>
      <div class="consent-copy consent-copy-th">
        <div class="consent-title-row">
          <img src="../images/KMUTT_Logo.png" alt="KMUTT" />
          <h2>การขอความยินยอมแบบคุกกี้</h2>
        </div>
        <p>
          เว็บไซต์นี้ใช้คุกกี้เพื่อปรับปรุงประสบการณ์ของผู้ใช้งานเว็บไซต์นี้จะถือว่าคุณให้ความยินยอมในการใช้คุกกี้ภายใต้นโยบายการใช้คุกกี้ของเรา
        </p>
        <p class="consent-links">
          <a href="https://www.kmutt.ac.th/privacy/" target="_blank">นโยบายความเป็นส่วนตัว</a>
          <span>-</span>
          <a href="https://www.kmutt.ac.th/website-policy/" target="_blank">ข้อกำหนดและเงื่อนไข</a>
        </p>
      </div>
      <div class="consent-actions">
        <div class="consent-language">
          <button type="button" data-consent-lang="en">EN</button>
          <button type="button" data-consent-lang="th">TH</button>
        </div>
        <button type="button" class="consent-accept" id="consentAccept">
          <span class="consent-en">Accept all</span>
          <span class="consent-th">ยอมรับทั้งหมด</span>
        </button>
        <button type="button" class="consent-reject" id="consentReject">
          <span class="consent-en">Reject all</span>
          <span class="consent-th">ปฏิเสธทั้งหมด</span>
        </button>
      </div>
    </div>
    <script src="/js/assets/consent.js"></script>
  </body>
</html>
